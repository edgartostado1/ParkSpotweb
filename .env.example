# Copia este archivo como ".env" y ajusta los valores a tu entorno.

# ----- Servidor -----
PORT=3000
SESSION_SECRET=cambia-esta-clave-secreta-por-una-larga-y-aleatoria

# ----- SQL Server (Autenticacion de Windows) -----
# Con autenticacion de Windows NO se usa usuario ni contrasena:
# la app se conecta con tu cuenta de Windows (igual que SSMS).
DB_HOST=localhost
DB_INSTANCE=SQLEXPRESS
DB_NAME=ParkSpot

# true si tu SQL Server usa certificado autofirmado (desarrollo local).
DB_TRUST_CERT=true
