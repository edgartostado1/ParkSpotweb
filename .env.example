# Copia este archivo como ".env" y ajusta los valores.

# ----- Servidor -----
PORT=3000
SESSION_SECRET=cambia-esta-clave-secreta-por-una-larga-y-aleatoria

# ----- SQL Server (autenticacion con usuario y contrasena) -----
# Sirve igual para local y para Azure SQL Database. En la nube cambiaras
# DB_HOST por el servidor de Azure y pondras DB_ENCRYPT=true.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=ParkSpot
DB_USER=parkspot
DB_PASS=TuPasswordAqui

# (Opcional) Instancia con nombre. Para SQL Express local pon SQLEXPRESS;
# en Azure dejalo vacio.
DB_INSTANCE=

# Cifrado de la conexion.
#   En local: DB_ENCRYPT=false  y  DB_TRUST_CERT=true
#   En Azure: DB_ENCRYPT=true   y  DB_TRUST_CERT=false
DB_ENCRYPT=false
DB_TRUST_CERT=true
