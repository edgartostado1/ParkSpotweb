<%- include('../partials/header') %>

<div class="app-shell">
    <%- include('../partials/nav', { user, activo: 'panel' }) %>

    <main class="content">
        <div class="welcome-card">
            <h1>Panel de Administrador</h1>
            <p>Hola <%= user.nombre %>, desde aqui gestionas ParkSpot.</p>
        </div>

        <div class="cards-grid">
            <a class="stat-card" href="/admin/espacios">
                <div class="icon">&#128661;</div>
                <h3>Espacios</h3>
                <p>Crear, editar y eliminar espacios.</p>
            </a>
            <a class="stat-card" href="/estacionamientos">
                <div class="icon">&#127359;</div>
                <h3>Estacionamientos</h3>
                <p>Ver el mapa y la disponibilidad.</p>
            </a>
            <div class="stat-card">
                <div class="icon">&#128197;</div>
                <h3>Reservas</h3>
                <p>Supervisa las reservas activas.</p>
            </div>
            <div class="stat-card">
                <div class="icon">&#128202;</div>
                <h3>Reportes</h3>
                <p>Proximamente: ocupacion e ingresos.</p>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>
