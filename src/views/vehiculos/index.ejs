<%- include('../partials/header') %>
<div class="app-shell">
    <%- include('../partials/nav', { user, activo: 'vehiculos' }) %>

    <main class="content">
        <div class="page-head">
            <h1>Mis vehiculos</h1>
            <p class="muted">Registra tus vehiculos para poder reservar espacios.</p>
        </div>

        <% if (flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
        <% if (flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

        <div class="two-col">
            <!-- Lista de vehiculos -->
            <div class="panel-card">
                <h3>Registrados</h3>
                <% if (vehiculos.length === 0) { %>
                    <p class="muted">Aun no tienes vehiculos.</p>
                <% } else { %>
                    <table class="data-table">
                        <thead>
                            <tr><th>Placa</th><th>Marca</th><th>Modelo</th><th>Color</th><th>Tipo</th></tr>
                        </thead>
                        <tbody>
                            <% vehiculos.forEach(function(v) { %>
                                <tr>
                                    <td><strong><%= v.placa %></strong></td>
                                    <td><%= v.marca %></td>
                                    <td><%= v.modelo %></td>
                                    <td><%= v.color %></td>
                                    <td><%= v.tipo_vehiculo %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } %>
            </div>

            <!-- Formulario de registro -->
            <div class="panel-card">
                <h3>Registrar vehiculo</h3>
                <form action="/vehiculos" method="POST">
                    <div class="form-group">
                        <label for="placa">Placa</label>
                        <input type="text" id="placa" name="placa" placeholder="ABC123" required>
                    </div>

                    <div class="form-group">
                        <label for="id_modelo">Marca y modelo</label>
                        <select id="id_modelo" name="id_modelo" required>
                            <option value="">Selecciona...</option>
                            <% modelos.forEach(function(m) { %>
                                <option value="<%= m.id_modelo %>"><%= m.marca %> &mdash; <%= m.nombre %></option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="id_color">Color</label>
                            <select id="id_color" name="id_color" required>
                                <option value="">Selecciona...</option>
                                <% colores.forEach(function(c) { %>
                                    <option value="<%= c.id_color %>"><%= c.nombre %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="id_tipo">Tipo</label>
                            <select id="id_tipo" name="id_tipo" required>
                                <option value="">Selecciona...</option>
                                <% tipos.forEach(function(t) { %>
                                    <option value="<%= t.id_tipo %>"><%= t.nombre %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn">Registrar</button>
                </form>
            </div>
        </div>
    </main>
</div>
<%- include('../partials/footer') %>
