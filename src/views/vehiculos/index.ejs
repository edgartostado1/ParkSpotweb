<%- include('../partials/header') %>
<div class="app-shell">
    <%- include('../partials/nav', { user, activo: 'vehiculos' }) %>

    <main class="content">
        <div class="page-head">
            <h1>Mis vehiculos</h1>
            <p class="muted">Registra tus vehiculos para poder reservar espacios.</p>
        </div>

        <% if (flash.success) { %><div class="alert alert-success"><%= flash.success %></div><% } %>
        <% if (flash.error) { %><div class="alert alert-error"><%= flash.error %></div><% } %>

        <div class="two-col">
            <!-- Lista de vehiculos -->
            <div class="panel-card">
                <h3>Registrados</h3>
                <% if (vehiculos.length === 0) { %>
                    <p class="muted">Aun no tienes vehiculos.</p>
                <% } else { %>
                    <table class="data-table">
                        <thead>
                            <tr><th>Placa</th><th>Marca</th><th>Modelo</th><th>Color</th></tr>
                        </thead>
                        <tbody>
                            <% vehiculos.forEach(function(v) { %>
                                <tr>
                                    <td><strong><%= v.placa %></strong></td>
                                    <td><%= v.marca || '-' %></td>
                                    <td><%= v.modelo || '-' %></td>
                                    <td><%= v.color || '-' %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } %>
            </div>

            <!-- Formulario de registro -->
            <div class="panel-card">
                <h3>Registrar vehiculo</h3>
                <form action="/vehiculos" method="POST">
                    <div class="form-group">
                        <label for="placa">Placa</label>
                        <input type="text" id="placa" name="placa" placeholder="ABC123" required>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="marca">Marca</label>
                            <input type="text" id="marca" name="marca" placeholder="Toyota">
                        </div>
                        <div class="form-group">
                            <label for="modelo">Modelo</label>
                            <input type="text" id="modelo" name="modelo" placeholder="Corolla">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="color">Color</label>
                            <input type="text" id="color" name="color" placeholder="Rojo">
                        </div>
                        <div class="form-group">
                            <label for="tipo_vehiculo">Tipo</label>
                            <input type="text" id="tipo_vehiculo" name="tipo_vehiculo" placeholder="Auto / Moto">
                        </div>
                    </div>
                    <button type="submit" class="btn">Registrar</button>
                </form>
            </div>
        </div>
    </main>
</div>
<%- include('../partials/footer') %>
