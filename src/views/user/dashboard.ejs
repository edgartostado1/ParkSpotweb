<%- include('../partials/header') %>

<div class="app-shell">
    <%- include('../partials/nav', { user, activo: 'panel' }) %>

    <main class="content">
        <div class="welcome-card">
            <h1>¡Hola, <%= user.nombre %>! &#128075;</h1>
            <p>Bienvenido a ParkSpot. Reserva un espacio en pocos pasos.</p>
        </div>

        <div class="cards-grid">
            <a class="stat-card" href="/estacionamientos">
                <div class="icon">&#128661;</div>
                <h3>Reservar</h3>
                <p>Ver estacionamientos y espacios libres.</p>
            </a>
            <a class="stat-card" href="/reservas">
                <div class="icon">&#128197;</div>
                <h3>Mis reservas</h3>
                <p>Consulta o cancela tus reservas.</p>
            </a>
            <a class="stat-card" href="/vehiculos">
                <div class="icon">&#128663;</div>
                <h3>Mis vehiculos</h3>
                <p>Registra y administra tus autos.</p>
            </a>
            <div class="stat-card">
                <div class="icon">&#127915;</div>
                <h3>Mis tickets</h3>
                <p>Proximamente: tickets digitales.</p>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/footer') %>
