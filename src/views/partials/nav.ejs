<%
  // Barra superior reutilizable. Recibe "user" y "activo" (para resaltar el enlace).
  const esAdmin = user && user.nombre_rol && user.nombre_rol.toLowerCase() === 'administrador';
%>
<header class="topbar">
    <div class="brand"><span class="logo-badge">P</span> ParkSpot</div>

    <nav class="main-nav">
        <% if (esAdmin) { %>
            <a href="/admin" class="<%= activo === 'panel' ? 'active' : '' %>">Panel</a>
            <a href="/admin/espacios" class="<%= activo === 'espacios' ? 'active' : '' %>">Espacios</a>
            <a href="/estacionamientos" class="<%= activo === 'estacionamientos' ? 'active' : '' %>">Estacionamientos</a>
        <% } else { %>
            <a href="/usuario" class="<%= activo === 'panel' ? 'active' : '' %>">Panel</a>
            <a href="/estacionamientos" class="<%= activo === 'estacionamientos' ? 'active' : '' %>">Reservar</a>
            <a href="/reservas" class="<%= activo === 'reservas' ? 'active' : '' %>">Mis reservas</a>
            <a href="/vehiculos" class="<%= activo === 'vehiculos' ? 'active' : '' %>">Mis vehiculos</a>
        <% } %>
    </nav>

    <div class="user-box">
        <span class="role-chip"><%= user.nombre_rol %></span>
        <span><%= user.nombre %></span>
        <a class="logout-link" href="/logout">Salir</a>
    </div>
</header>
